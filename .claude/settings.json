{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "^story-planner$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/us-json-gate.mjs\" --mode script",
            "timeout": 240
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(/.workflow-artifacts/**/test-ideas.json)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/artifact-gate.mjs\" --trigger write",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
