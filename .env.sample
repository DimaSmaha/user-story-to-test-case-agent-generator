ISSUE_TRACKER=
FAKE_TRACKER_URL=
APP_URL=
APP_USERNAME=
APP_PASSWORD=

# Server
SERVER_PORT=4000
NODE_ENV=development

# Set a secret string to enable API key auth on /api/* routes.
# Leave empty to disable auth (useful for local development).
API_KEY=

# Tune pipeline timeouts (milliseconds). Defaults: 40min / 60min.
# JOB_TIMEOUT_MS=2400000
# BATCH_TIMEOUT_MS=3600000

# Optional: set these if bash / node are not on PATH (Windows only)
# GIT_BASH=C:\Program Files\Git\usr\bin\bash.exe
# NODE_EXE=C:\Program Files\nodejs\node.exe
